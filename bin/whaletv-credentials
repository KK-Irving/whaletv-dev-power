#!/usr/bin/env node
// Unix wrapper for whaletv-credentials.mjs
// PATH 通过 scripts/deploy.mjs 管理，指向 <repo>/bin/
// 允许从任意目录调用；自动定位到脚本真实位置。

import { spawnSync } from 'node:child_process';
import path from 'node:path';
import { fileURLToPath, pathToFileURL } from 'node:url';
import fs from 'node:fs';

const __filename = fileURLToPath(import.meta.url);
// bin/whaletv-credentials 是 symlink 也支持：realpath 拿真实位置
const realPath = fs.realpathSync(__filename);
const binDir = path.dirname(realPath);
const scriptPath = path.resolve(binDir, '..', 'scripts', 'whaletv-credentials.mjs');

if (!fs.existsSync(scriptPath)) {
  console.error(`error: 未找到实际脚本 ${scriptPath}`);
  console.error('       可能仓库结构损坏。请重新拉最新代码或跑 scripts/deploy.mjs 修复。');
  process.exit(1);
}

// 通过 import() 直接加载 mjs 脚本（比 spawnSync 快、且 stdout/stderr 直连）
process.argv = [process.argv[0], scriptPath, ...process.argv.slice(2)];
await import(pathToFileURL(scriptPath).href);
